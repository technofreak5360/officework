# Copied to .env on first container start (see docker/entrypoint.sh).
# APP_KEY is generated at that point, so never commit a value here.
# The defaults work with docker-compose.yml and need no accounts.

APP_NAME="Product Catalogue"
APP_ENV=local
APP_KEY=
# Keeps stack traces out of API responses. They still go to the logs.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Lets the API handle parallel requests from the frontend.
PHP_CLI_SERVER_WORKERS=4

# Sends logs to `docker compose logs api`.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Kept on a named volume. Moving to MySQL/Postgres is a config change.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

# The API is stateless, so it doesn't need sessions.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mailpit locally. Point these at a real provider to send real email.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="catalogue@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT_SECONDS=5

# Who receives new enquiries.
SALES_INBOX_ADDRESS=sales@example.com

# Where product data comes from: "fakestore", or "fixture" to run from a local
# copy with no network calls. Restart the api service after changing this.
CATALOGUE_DRIVER=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_SECONDS=5
FAKESTORE_CACHE_SECONDS=600

# The owner's home page picks, in display order.
FEATURED_PRODUCT_IDS=3,5,11,12,18

# How many products a category page shows as top rated.
CATEGORY_TOP_RATED_COUNT=3
