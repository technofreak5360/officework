# Copied to .env on first container start (see docker/entrypoint.sh).
# APP_KEY is generated at that point, so never commit a value here.
# The defaults work with docker-compose.yml and need no accounts.

APP_NAME="Product Catalogue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Lets the API handle parallel requests from the frontend.
PHP_CLI_SERVER_WORKERS=4

# Sends logs to `docker compose logs api`.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Kept on a named volume. Moving to MySQL/Postgres is a config change.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

# The API is stateless, so it doesn't need sessions.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mailpit locally. Point these at a real provider to send real email.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="catalogue@example.com"
MAIL_FROM_NAME="${APP_NAME}"
